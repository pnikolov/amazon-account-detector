{
  "manifest_version": 3,
  "name": "Amazon Account Detector",
  "version": "1.0.0",
  "description": "Shows which Amazon account is signed in on a chosen marketplace, without opening or touching any tab.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Amazon Account Detector",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "permissions": ["storage", "alarms", "offscreen", "cookies"],
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://*.amazon.co.uk/*",
    "https://*.amazon.de/*",
    "https://*.amazon.it/*",
    "https://*.amazon.fr/*"
  ]
}
